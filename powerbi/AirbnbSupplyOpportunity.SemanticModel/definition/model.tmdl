model AirbnbSupplyOpportunity
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table 'Dim City'
ref table 'Dim Neighborhood'
ref table 'Dim Room Type'
ref table 'Fact Listings'
ref table 'Fact Opportunity Segments'
ref table 'Fact Statistical Results'
ref table 'Fact Quality Summary'
ref table 'Build Control'
ref table _Measures

