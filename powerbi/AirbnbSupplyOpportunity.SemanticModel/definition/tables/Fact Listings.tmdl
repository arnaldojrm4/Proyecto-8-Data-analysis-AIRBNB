	partition 'Fact Listings' = m
		mode: import
		source =
				let
				    GuardRows = Table.RowCount(BuildGuard),
				    Output = CsvFromRoot("fact_listings.csv", {{"listing_key", type text}, {"city_key", type text}, {"neighborhood_key", type text}, {"room_type_key", type text}, {"price", type number}, {"minimum_nights", Int64.Type}, {"number_of_reviews", Int64.Type}, {"reviews_per_month_observed", type number}, {"activity_proxy", type number}, {"activity_proxy_derived_zero", type logical}, {"activity_proxy_is_analyzable", type logical}, {"price_is_valid", type logical}, {"minimum_nights_is_valid", type logical}, {"coordinate_is_valid", type logical}})
				in
				    if GuardRows > 0 then Output else error Error.Record("Release bloqueada", "build_control.csv no contiene filas.", null)

