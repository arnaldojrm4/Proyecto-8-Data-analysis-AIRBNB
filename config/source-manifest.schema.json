{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airbnb source manifest",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "source_id", "city_key", "display_city_es", "file_name", "relative_path",
          "sha256", "byte_size", "parsed_row_count", "column_names", "encoding",
          "delimiter", "provenance_status", "license_status"
        ],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "parsed_row_count": {"type": "integer", "minimum": 1},
          "byte_size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
